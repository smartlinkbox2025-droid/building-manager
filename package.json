{
  "name": "building-manager-pwa",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-project.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run validate && tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "check": "npm run validate && npm run typecheck && vite build --configLoader runner",
    "acceptance": "npm run build && node scripts/acceptance-check.mjs && node scripts/validate-xlsx.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.0.11",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
